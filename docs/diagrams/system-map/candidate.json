 "cards": [
  {
   "dot": "violet",
   "title": "Main path",
   "items": [
    "React UI \u2192 invoke() \u2192 Tauri command \u2192 inbox2-core \u2192 inbox2.db",
    "Every client reads the same SQLite file; writes go through the engine"
   ]
  },
  {
   "dot": "cyan",
   "title": "inbox2 cloud (api.inbox2.com)",
   "items": [
    "MX sync REST: sync/head, pull, backfill, keys, threads",
    "ActionCable push hints: OrganizationChannel, PushSyncChannel",
    "OAuth proxy for Gmail/Microsoft token refresh",
    "Image proxy and open-tracking pixel GET /o/:token.gif"
   ]
  },
  {
   "dot": "amber",
   "title": "Engine bus",
   "items": [
    "engine.sock: first process to bind is HOST and runs the SyncEngine",
    "Inbox2 app or engine_daemon can host; the CLI attaches as a client",
    "CLI reads inbox2.db directly; mutations go over RPC"
   ]
  },
  {
   "dot": "slate",
   "title": "AI and MCP",
   "items": [
    "TypeSafe Jev: triage labels, priority, Space",
    "OpenAI lane only when allowed; sealed mail never leaves the device",
    "Local lane: llama-server (GGUF) or FoundationModelsBridge (Swift)",
    "Inbound MCP server: 23 tools over loopback, off by default",
    "Outbound MCP client: Streamable HTTP + OAuth 2.1, drafts only"
   ]
  }
 ]
