 "cards": [
  {
   "dot": "cyan",
   "title": "The funnel",
   "items": [
    "Tier 0: deterministic predicates over SQLite fields (from, to, subject, has_attachment)",
    "Tier 1: embeds message + rule phrase with the on-device MiniLM model; passes on cosine \u2265 threshold",
    "Gate fails closed: no model loaded \u2192 no dispatch",
    "Agents never run inline; run_agent inserts a pending agent_runs row"
   ]
  },
  {
   "dot": "amber",
   "title": "AgentRunner",
   "items": [
    "Polls every 5 s; also built by engine_daemon",
    "Scratch dir <app_data>/agent_runs/<run_key>/: email.eml, body.txt, context.json, task.md, attachments/",
    "Agent cwd is the scratch dir, never the user's files",
    "Success = exit 0 and result.json with status ok; stdout only for audit + cost",
    "Timeout, retries, failed runs listed with retry"
   ]
  },
  {
   "dot": "rose",
   "title": "Permission posture per rule",
   "items": [
    "allowlist: restricted tools (Claude dontAsk + allowedTools, Codex workspace-write); OpenCode unsupported",
    "approval_first: full access, first firing waits in agent_approvals",
    "full_auto: full access, fires immediately; max injection exposure",
    "Email content is untrusted data; the harness preamble says so"
   ]
  }
 ]
}