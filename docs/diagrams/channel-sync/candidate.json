 "cards": [
  {
   "dot": "emerald",
   "title": "Optimistic write",
   "items": [
    "engine/conversation_actions.rs applies the change to SQLite first",
    "writeback_actions row queued; the 5 s drain is kicked",
    "UI never waits for Gmail"
   ]
  },
  {
   "dot": "amber",
   "title": "Write-back and settle guard",
   "items": [
    "5 s tick drains writeback_actions with exponential backoff",
    "Gmail: messages.modify; IMAP: UID STORE/MOVE; Graph: PATCH/move",
    "Completed rows kept WRITEBACK_SETTLE_GRACE_SECS = 180",
    "A sync showing pre-mutation flags is ignored while the row is pending or retained"
   ]
  },
  {
   "dot": "cyan",
   "title": "Resync",
   "items": [
    "ActionCable PushSyncChannel carries no mail data, only a hint",
    "The 60 s tick polls every account the same way",
    "Incremental sync applies provider changes; UI re-reads SQLite on the sync event"
   ]
  }
 ]
