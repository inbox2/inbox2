 "cards": [
  {
   "dot": "amber",
   "title": "Host election (ipc.rs start_or_attach)",
   "items": [
    "connect(engine.sock) succeeds \u2192 CLIENT",
    "else delete stale socket, bind \u2192 HOST runs the SyncEngine",
    "race \u2192 CLIENT; engine_daemon prints HOST or ATTACH",
    "CLI reads inbox2.db directly, mutates over RPC",
    "Non-Unix: no bus, engine runs in-process"
   ]
  },
  {
   "dot": "violet",
   "title": "Windows",
   "items": [
    "main: 1440\u00d7900, transparent, hudWindow, backgroundThrottling off",
    "tray: lazily created on menu-bar click, NSPanel that may become key",
    "notification: created from JS, converted to a non-activating NSPanel",
    "capabilities/default.json covers main, notification, tray"
   ]
  },
  {
   "dot": "slate",
   "title": "Sidecars and workers",
   "items": [
    "llama-server: GGUF (default qwen2.5-1.5b-instruct)",
    "FoundationModelsBridge: macOS 26 Swift subprocess",
    "MCP server: off by default, bearer token in <data>/mcp-token",
    "AgentRunner: scratch dir per run, result.json read back"
   ]
  },
  {
   "dot": "rose",
   "title": "Dev vs prod identity",
   "items": [
    "prod com.inbox2.desktop / dev com.inbox2.desktop.dev",
    "separate data dir, Keychain service, engine.sock, single-instance lock",
    "deep-link scheme inbox2 vs inbox2-dev",
    "dev talks to http://localhost:4000, prod to api.inbox2.com",
    "both can run at once; they never see each other's mail"
   ]
  }
 ]
