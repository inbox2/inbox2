 "cards": [
  {
   "dot": "slate",
   "title": "Dependency direction",
   "items": [
    "ffi.rs wraps every layer: ~96 InboxEngine methods, EngineEventListener + OnDeviceLlm callbacks",
    "Engine uses Providers and Storage; nothing below the store calls up",
    "MX, AI, Lore, Rules and the MCP client use Storage only",
    "Providers are the only modules that speak to mail servers"
   ]
  },
  {
   "dot": "emerald",
   "title": "Storage (sync/store/*)",
   "items": [
    "mod.rs opens SQLite: WAL, foreign keys, busy_timeout 5000, schema + ALTER upgrades",
    "queue.rs: write-back queue, WRITEBACK_SETTLE_GRACE_SECS = 180",
    "mx.rs: version guard on change_seq, settle guard, MX_SCHEMA_VERSION = 2",
    "secrets.rs: encrypted credentials and app_secrets; crypto.rs device-bound key"
   ]
  },
  {
   "dot": "rose",
   "title": "Sealed mail",
   "items": [
    "seal.rs decrypts only; interop-locked to the Go and libsodium producers",
    "Opened text stored locally, never sent to a cloud AI lane",
    "agent_* views exclude sealed threads for MCP clients"
   ]
  }
 ]
