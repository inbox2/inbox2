 "cards": [
  {
   "dot": "cyan",
   "title": "Read pass order",
   "items": [
    "head: horizon now; cursor recorded; directory re-listed (start, hourly, scope: directory hint)",
    "delta: sync/pull?since=, cursor saved after every page",
    "backfill: sync/backfill, 5 pages per pass, resumable token",
    "reconcile: sync/keys; delete locals not listed, re-hydrate version drift",
    "hydrate: sync/threads replaces each thread's message + note set"
   ]
  },
  {
   "dot": "amber",
   "title": "Writes",
   "items": [
    "mx_action updates the local row first, then queues mx_writeback_actions",
    "mx_drain (5 s tick) posts to orgs/{org}/conversations/bulk",
    "mx_send \u2192 mx_outbox, drained on the 5 s tick; never dropped on mirror reset",
    "mx_tick (60 s): failsafe pass per org + mx_push_busy \u2192 PUT orgs/{org}/external-busy"
   ]
  },
  {
   "dot": "rose",
   "title": "Sealed mail",
   "items": [
    "seal.rs opens sealed payloads; plaintext kept locally while the bundle is byte-identical",
    "sealed rows never go to a cloud AI lane",
    "agent_conversations / agent_messages exclude any thread holding a sealed message",
    "mirror reset when engine_settings.mx_schema_version \u2260 2"
   ]
  }
 ]
