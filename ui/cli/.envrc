# direnv: auto-activate the CLI's virtualenv on `cd` into ui/cli (and deactivate
# on leaving). Approve once with `direnv allow`. Requires direnv (already hooked
# into the shell). Falls back to a hint if the venv hasn't been created yet.
if [[ -f .venv/bin/activate ]]; then
  source .venv/bin/activate
else
  echo "ui/cli: no .venv yet — run: python3 -m venv .venv && .venv/bin/pip install -e '.[test]'"
fi
