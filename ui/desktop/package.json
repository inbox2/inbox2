{
  "name": "inbox2-desktop",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Inbox2 Desktop Client (Tauri)",
  "type": "module",
  "scripts": {
    "dev": "INBOX2_BUNDLE_ID=com.inbox2.desktop.dev tauri dev -c src-tauri/tauri.dev.conf.json",
