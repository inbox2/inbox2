    "release": "../../bin/release-desktop"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-sql": "^2.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "vitest": "^4.1.10"
  }
