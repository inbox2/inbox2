  "scripts": {
    "dev": "vite",
    "build": "eslint . && vite build",
    "build:pages": "vite build --mode pages",
    "lint": "eslint .",
    "test": "vitest run",
    "test:email": "vitest run --project unit ../../packages/email-body src/components/MessageCard/__tests__",
    "e2e": "playwright test",
    "e2e:seed": "cd ../../api && RAILS_ENV=development bin/rails db:seed",
    "e2e:disk": "node e2e/disk/prepare.mjs && playwright test -c e2e/disk/playwright.config.js --project=chromium --project=firefox --project=webkit",
    "e2e:disk:screens": "node e2e/disk/prepare.mjs && playwright test -c e2e/disk/playwright.config.js --project=screens",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "//resolutions": "ProseMirror must be a SINGLE copy: prosemirror-transform/-view check nodes with `instanceof`, so a second prosemirror-model makes Enter (splitBlock) throw `Can not convert <> to a Fragment`. @tiptap/pm asks for a newer range than y-prosemirror et al, and Yarn 1 nests instead of deduping. Bump these when @tiptap/pm does.",
  "//resolutions-security": "adm-zip / sharp are transitive via @huggingface/transformers; their parents pin ^0.5.16 / ^0.34.5 which won't accept the CVE fixes on their own. Forced to patched versions: adm-zip CVE-2026-39244 (zip-slip), sharp GHSA-f88m-g3jw-g9cj. Drop these once transformers bumps its deps.",
  "resolutions": {
    "prosemirror-model": "1.25.11",
    "prosemirror-view": "1.42.2",
