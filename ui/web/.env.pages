# Cloudflare Pages build (`vite build --mode pages` → `yarn build:pages`).
#
# The web app is served from mail.inbox2.com and talks to the API cross-origin
# at api.inbox2.com. This is NOT loaded by the default `vite build` (production
# mode) that the Tauri desktop bundle uses — desktop/dev stay same-origin.
#
# Override in the Cloudflare Pages dashboard (Settings → Environment variables)
# to point a preview deploy at a different API.
VITE_API_ORIGIN=https://api.inbox2.com

# Disk exact view: where the packed LibreOffice engine is hosted (R2 bucket
# inbox2-engine, public; upload with scripts/disk-engine-pack.mjs then
# `wrangler r2 object put`). hd.inbox2.com is the bucket's custom domain
# (2026-10-04; was the rate-limited pub-….r2.dev). Bucket CORS must list every
# web origin: `wrangler r2 bucket cors list inbox2-engine`.
VITE_DISK_ENGINE_URL=https://hd.inbox2.com

# Disk's own host (same build, Disk at the root; lib/disk/model.js). The mail
# host sends /disk/... there. Unset in dev, where Disk stays under /disk.
VITE_DISK_ORIGIN=https://disk.inbox2.com
# And back: the disk host sends everything that is not Disk, sign-in or a public link here.
VITE_MAIL_ORIGIN=https://mail.inbox2.com

# The admin console's own host (same build, the console at the root; lib/consoleHost.js).
# The mail and disk hosts send /console/... there, and it sends mail paths back.
VITE_CONSOLE_ORIGIN=https://console.inbox2.com

# Errors page on Pushleft (src/lib/sentry.js). A browser DSN is public by design:
# it can only send events. Its own key ("web"), revocable with pl errors dsn revoke.
VITE_SENTRY_DSN=https://f2fd9f73879a247b3c459717a4d38541@errors.pushleft.dev/7475980664
