<%#
  Disk: something was shared with the reader (Disk::ShareNotifier).
  Locals: title (String), body (String), url (String, absolute link into Disk).
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %></title>
</head>
<body style="margin:0;padding:0;background:#f2ede2;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f2ede2;">
    <tr>
      <td align="center" style="padding:32px 16px;">
        <table role="presentation" width="560" cellpadding="0" cellspacing="0" style="width:560px;max-width:100%;background:#fcfaf4;border:1px solid rgba(24,34,66,0.13);border-radius:14px;">
          <tr>
            <td style="padding:24px 28px;border-bottom:1px solid rgba(24,34,66,0.09);">
              <span style="font:700 20px/1 Georgia,'Iowan Old Style',serif;color:#182242;">inbox2</span>
            </td>
          </tr>
          <tr>
            <td style="padding:32px 28px 8px;">
              <div style="font:700 24px/1.25 Georgia,serif;color:#182242;"><%= title %></div>
              <div style="font:400 15px/1.6 Arial,sans-serif;color:#5b6178;padding-top:14px;"><%= body %></div>
            </td>
          </tr>
          <tr>
            <td style="padding:20px 28px 8px;">
              <a href="<%= url %>" style="display:inline-block;padding:12px 22px;background:#182242;color:#fcfaf4;border-radius:10px;font:600 14px/1 Arial,sans-serif;text-decoration:none;">Open in Disk</a>
            </td>
          </tr>
          <tr>
            <td style="padding:16px 28px 32px;">
              <div style="font:400 12px/1.6 Arial,sans-serif;color:#8d92a5;">Or paste this link into your browser: <%= url %></div>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
