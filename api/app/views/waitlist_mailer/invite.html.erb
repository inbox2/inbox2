<%#
  Invite email — sent to a prospect when an operator invites them. On-brand with
  the inbox2 landing page. Single CTA to create their account, plus a plaintext
  fallback link. Locals: signup (WaitlistSignup), invite_url (String).
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>You're in — create your inbox2 account</title>
  <style>@import url('https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500;600&display=swap');</style>
</head>
<body style="margin:0;padding:0;background:#000000;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#000000;">
    <tr>
      <td align="center" style="padding:32px 16px;">
        <table role="presentation" width="560" cellpadding="0" cellspacing="0" style="width:560px;max-width:100%;background:#0c0d11;border:1px solid #ffffff;">
          <tr>
            <td style="padding:24px 28px;border-bottom:1px solid rgba(255,255,255,0.16);">
              <span style="font:700 22px/1 'Chakra Petch',Arial,sans-serif;color:#ffffff;letter-spacing:-.01em;">inbox2</span>
            </td>
          </tr>
          <tr>
            <td style="padding:36px 28px 8px;">
              <div style="font:600 11px/1 'JetBrains Mono',ui-monospace,monospace;letter-spacing:.16em;text-transform:uppercase;color:#2f7ad6;padding-bottom:14px;">Your invite is here</div>
              <div style="font:700 26px/1.2 'Chakra Petch',Arial,sans-serif;color:#ffffff;">You're in<% if signup.name.present? %>, <%= signup.name.split.first %><% end %>.</div>
              <div style="font:400 15px/1.6 'Inter',Arial,sans-serif;color:#aab2c0;padding-top:14px;">
                Thanks for your interest in inbox2 — collaborative, domain-based team email with routing rules and AI agents. Your spot is ready. Use the button below to create your account and get started.
              </div>
            </td>
          </tr>
          <tr>
            <td style="padding:28px 28px 8px;">
              <table role="presentation" cellpadding="0" cellspacing="0">
                <tr>
                  <td style="background:#2f7ad6;border:1px solid #47bfff;">
                    <a href="<%= invite_url %>" style="display:inline-block;padding:14px 28px;font:600 14px/1 'JetBrains Mono',ui-monospace,monospace;letter-spacing:.06em;text-transform:uppercase;color:#ffffff;text-decoration:none;">Create my account</a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td style="padding:18px 28px 36px;">
              <div style="font:400 12px/1.6 'Inter',Arial,sans-serif;color:#6b7280;">
                Or paste this link into your browser:<br>
                <a href="<%= invite_url %>" style="color:#47bfff;text-decoration:none;word-break:break-all;"><%= invite_url %></a>
              </div>
            </td>
          </tr>
          <tr>
            <td style="padding:16px 28px;border-top:1px solid rgba(255,255,255,0.16);font:500 11px/1.5 'JetBrains Mono',ui-monospace,monospace;letter-spacing:.08em;text-transform:uppercase;color:#6b7280;">
              This invite link is personal to you — please don't forward it.
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
