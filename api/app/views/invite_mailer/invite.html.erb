<%#
  Teammate-invite email — sent when someone is invited to private mailboxes on
  one or more inbox2 domains. Same console design language as the waitlist
  invite. Single CTA to set a password and get started, plus a plaintext
  fallback link. If the invitee already has an inbox2 account, the same link
  asks them to sign in and then activates the invites.
  Locals: inviter (User), addresses (Array<String>), accept_url (String).
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>You've been invited to inbox2</title>
  <style>@import url('https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500;600&display=swap');</style>
</head>
<body style="margin:0;padding:0;background:#000000;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#000000;">
    <tr>
      <td align="center" style="padding:32px 16px;">
        <table role="presentation" width="560" cellpadding="0" cellspacing="0" style="width:560px;max-width:100%;background:#0c0d11;border:1px solid #ffffff;">
          <tr>
            <td style="padding:24px 28px;border-bottom:1px solid rgba(255,255,255,0.16);">
              <span style="font:700 22px/1 'Chakra Petch',Arial,sans-serif;color:#ffffff;letter-spacing:-.01em;">inbox2</span>
            </td>
          </tr>
          <tr>
            <td style="padding:36px 28px 8px;">
              <div style="font:600 11px/1 'JetBrains Mono',ui-monospace,monospace;letter-spacing:.16em;text-transform:uppercase;color:#2f7ad6;padding-bottom:14px;">Team invitation</div>
              <div style="font:700 26px/1.2 'Chakra Petch',Arial,sans-serif;color:#ffffff;">You have a new mailbox.</div>
              <div style="font:400 15px/1.6 'Inter',Arial,sans-serif;color:#aab2c0;padding-top:14px;">
                <%= inviter.username %> invited you to the team on inbox2 — collaborative, domain-based team email. <%= addresses.length == 1 ? "This address is" : "These addresses are" %> now yours:
              </div>
            </td>
          </tr>
          <tr>
            <td style="padding:20px 28px 0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid rgba(255,255,255,0.16);">
                <% addresses.each do |address| %>
                  <tr>
                    <td style="padding:12px 16px;border-bottom:1px solid rgba(255,255,255,0.08);font:600 14px/1 'JetBrains Mono',ui-monospace,monospace;color:#ffffff;"><%= address %></td>
                  </tr>
                <% end %>
              </table>
            </td>
          </tr>
          <tr>
            <td style="padding:28px 28px 8px;">
              <table role="presentation" cellpadding="0" cellspacing="0">
                <tr>
                  <td style="background:#2f7ad6;border:1px solid #47bfff;">
                    <a href="<%= accept_url %>" style="display:inline-block;padding:14px 28px;font:600 14px/1 'JetBrains Mono',ui-monospace,monospace;letter-spacing:.06em;text-transform:uppercase;color:#ffffff;text-decoration:none;">Set my password</a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td style="padding:18px 28px 36px;">
              <div style="font:400 12px/1.6 'Inter',Arial,sans-serif;color:#6b7280;">
                Or paste this link into your browser:<br>
                <a href="<%= accept_url %>" style="color:#47bfff;text-decoration:none;word-break:break-all;"><%= accept_url %></a>
              </div>
            </td>
          </tr>
          <tr>
            <td style="padding:16px 28px;border-top:1px solid rgba(255,255,255,0.16);font:500 11px/1.5 'JetBrains Mono',ui-monospace,monospace;letter-spacing:.08em;text-transform:uppercase;color:#6b7280;">
              This invite link is personal to you — please don't forward it.
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
