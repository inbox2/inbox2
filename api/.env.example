GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# Brokered app OAuth (docs/App-OAuth.md) — a SEPARATE Google "Web application"
# client, because that flow redirects to https://api.inbox2.com/... and Google
# only allows an HTTPS redirect URI on a web client (the one above is a
# desktop/installed client, which needs arbitrary loopback ports). Unset = the
# broker falls back to the client above. Microsoft needs no equivalent: one app
# registration carries both the Web and the mobile/desktop platform.
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_SECRET=your-google-web-client-secret

# Cloud push for local channels (Gmail/Office365) — see docs/Cloud-Push.md
# Public HTTPS base providers POST webhooks to (Cloudflare Tunnel / Tailscale Funnel in dev).
PUSH_WEBHOOK_BASE_URL=https://your-tunnel.example.com
# Cloud Pub/Sub topic the Gmail watch publishes to.
GMAIL_PUBSUB_TOPIC=projects/your-gcp-project/topics/gmail-push
# Shared token appended to the Pub/Sub push subscription URL (?token=...). Unset = accept unverified (dev only).
GMAIL_PUBSUB_VERIFICATION_TOKEN=generate-with-openssl-rand-hex-24

# Meta channels (WhatsApp/Messenger/Instagram) webhook relay — see docs/Meta-Setup.md
# Verify token Meta echoes on the GET webhook handshake. The on-device client
# fetches it (GET /meta-channel-subscriptions/config) and uses it when it
# auto-configures each app's webhook. Unset = the relay accepts any token AND the
# client skips auto-config (set it for production; generate with openssl rand -hex 24).
META_WEBHOOK_VERIFY_TOKEN=generate-with-openssl-rand-hex-24

# Jev triage (docs/Triage.md) — TypeSafe System One. Unset = MX threads go to the
# holding pen with no label/priority. TYPESAFE_MODEL pins the model (default
# jev-1.13.0; the thresholds were set on it). OPENAI_API_KEY stays for summaries.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=
