source "https://rubygems.org"

gem "rails", "~> 8.1.3"
gem "propshaft"
gem "pg", "~> 1.1"
gem "puma", ">= 5.0"

# Pin above the Ruby-bundled default gem: CVE-2026-80212 (fixed 0.7.2), caught
# by an image scan of the api image.
gem "resolv", ">= 0.7.2"

# JSON serialization (spec E2, 16.3.2)
gem "alba", "~> 3.0"

# Authentication
gem "bcrypt", "~> 3.1.7"

# Public IDs (spec E5)
gem "nanoid", "~> 2.0"

# CORS for React frontend
gem "rack-cors"

# TOTP two-factor authentication (spec 2.1.5)
gem "rotp", "~> 6.3"

# QR code generation for TOTP enrollment
gem "rqrcode", "~> 3.2"

# Windows timezone data
gem "tzinfo-data", platforms: %i[ windows jruby ]

# Action Cable with Postgres adapter (no Redis — spec 16.1.2)
gem "solid_cable"

# Background jobs
gem "solid_queue"

# Cache
gem "solid_cache"

gem "bootsnap", require: false

# Load .env files in development/test
gem "dotenv-rails", groups: [:development, :test]

group :development, :test do
  gem "debug", platforms: %i[ mri windows ], require: "debug/prelude"
  gem "rspec-rails", "~> 8.0"
  gem "factory_bot_rails", "~> 6.5"
  gem "faker", "~> 3.0"
  gem "shoulda-matchers", "~> 8.0"
  gem "rubocop-rails-omakase", require: false # Ruby style lint (bin/rubocop)
end

group :test do
  gem "database_cleaner-active_record", "~> 2.0"
  # JUnit XML for the Pushleft test run (scripts/ci/tests.sh).
  gem "rspec_junit_formatter", require: false
end

group :development do
  gem "web-console"
end

gem "webauthn", "~> 3.4"

gem "omniauth", "~> 2.1"
gem "omniauth-google-oauth2", "~> 1.2"
gem "omniauth-rails_csrf_protection", "~> 2.0"

gem "ruby-saml", "~> 1.18"

gem "rack-attack", "~> 6.8"

# Verifies the signed requests of the Pushleft Admin page (PushleftAdminController).
# Already in the bundle through webauthn and omniauth.
gem "jwt", "~> 3.2"

# NATS/JetStream client for inbound mail pipeline (spec 16.1.1, 16.2.3)
gem "nats-pure", "~> 2.4"

# S3-compatible object storage for attachments (Garage, spec 16.5.2)
gem "aws-sdk-s3", "~> 1.0"

# Amazon SES — optional outbound deliverability provider (DeliveryProviders::Ses)
gem "aws-sdk-sesv2", "~> 1.0"

# DMARC rua aggregate reports arrive as .zip attachments (TODO 46.10)
gem "rubyzip", "~> 3.4", require: "zip"

gem "icalendar", "~> 2.12"
gem "ice_cube", "~> 0.17.0"

# Mobile push (docs/Cloud-Push.md). APNs mandates HTTP/2, which stdlib
# Net::HTTP can't speak — apnotic brings its own HTTP/2 client and signs the
# p8 token itself. FCM v1 needs only service-account OAuth; transport is Net::HTTP.
gem "apnotic", "~> 1.7"
gem "googleauth", "~> 1.11"

# libsodium bindings for E2EE outbound sealing (docs/E2EE.md Phase I):
# crypto_box_seal + XChaCha20-Poly1305, interop with the Go MX + web client.
gem "rbnacl", "~> 7.1"

gem "prosopite", "~> 2.2", group: :test
gem "pg_query", "~> 6.2", group: :test
